# ============================================
# Yarniq Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000

# MongoDB Atlas (Free M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yarniq?retryWrites=true&w=majority

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Gmail SMTP (App Password)
# Enable 2FA on your Google account, then generate an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Admin
ADMIN_EMAIL=admin@gmail.com

# Frontend URL (for CORS)
FRONTEND_URL=https://yarniq.vercel.app
